# Copy to .env on the server. `shopify app dev` sets the SHOPIFY_* values itself.

# --- Shopify (set by the CLI in dev; set by hand in production) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_products,read_orders,write_app_proxy

# --- Help Desk email (ticket alerts to the store, confirmations and replies to customers) ---
# Without SMTP_HOST, SMTP_USER and SMTP_PASS, emails are skipped and the admin shows a notice.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional; defaults to SMTP_USER.
SMTP_FROM=

# --- AI photo check (optional tuning) ---
# Detector credentials (Sightengine / TruthScan) are entered per store in
# Help Desk > Settings > Photos, not here.
# AI_DETECTOR_TIMEOUT_MS=30000
# AI_SCAN_CONCURRENCY=2
# AI_SCAN_PER_STORE_PER_MINUTE=20
# AI_SCAN_STALE_MS=600000
