// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model HelpDeskTicket {
  id          String @id @default(cuid())
  shop        String
  requestKey  String
  name        String
  email       String
  topic       String
  details     String
  products    String
  // Wrong-delivery tickets: products the customer received instead of the ones in products.
  receivedProducts String @default("[]")
  status      String @default("Open")
  // Customer-facing ticket number, sequential per shop from 1001.
  number      Int    @default(0)
  priority    String @default("Normal")
  assignee    String @default("")
  // Comma-separated.
  tags        String @default("")
  // When the customer asked the request page's assistant for a person (or it
  // couldn't answer them). From then on the assistant leaves the chat to the team.
  humanRequestedAt DateTime?
  // Internal classification (app/services/help-desk-taxonomy.ts), set
  // automatically on arrival and corrected by agents. Empty means not set.
  category       String @default("")
  subcategory    String @default("")
  rootCause      String @default("")
  // What the team did: refund, replacement, store credit...
  resolutionType String @default("")
  // The ticket's Shopify order, saved when the ticket arrives and refreshed when
  // staff open it (app/services/help-desk-orders.server.ts). orderVerified: the
  // order was placed with the ticket's email, so the customer may see its tracking.
  orderId        String  @default("")
  orderName      String  @default("")
  orderValue     Float?
  orderCurrency  String  @default("")
  orderCountry   String  @default("")
  carrier        String  @default("")
  trackingNumber String  @default("")
  trackingUrl    String  @default("")
  shipmentStatus String  @default("")
  // Comma-separated SKUs on the order.
  orderSkus      String  @default("")
  orderVerified  Boolean @default(false)
  orderSyncedAt  DateTime?
  // Shopify customer ID when a signed-in shopper submitted the ticket.
  customerId  String @default("")
  // Secret for the customer's tracking link; never shown to other shoppers.
  accessToken String @unique @default("")
  unread      Boolean @default(true)
  // Staff turn this on when they want photos: only then does the customer's
  // request page offer "Add photos" with their reply.
  allowPhotos Boolean @default(false)
  // Staff let the customer add a video (e.g. a lid that won't close) to their reply.
  allowVideos Boolean @default(false)
  // form (storefront Help Desk form) or chat (escalated from the chat widget).
  channel     String @default("form")
  // Order cancellation requests (app/services/help-desk-cancel.server.ts).
  // cancelStatus: empty (not a cancellation), Pending, Approved, Rejected or
  // Cancelled. cancelNote: what staff told the customer with the decision.
  cancelStatus    String    @default("")
  cancelNote      String    @default("")
  cancelDecidedBy String    @default("")
  cancelDecidedAt DateTime?
  // Shipping address change requests (app/services/help-desk-address.server.ts).
  // addressStatus: empty (not an address change), Pending, Updated or Rejected.
  // addressApplied: the address set in Shopify (JSON), which staff may have corrected.
  addressStatus    String    @default("")
  addressNote      String    @default("")
  addressApplied   String    @default("")
  addressDecidedBy String    @default("")
  addressDecidedAt DateTime?
  // Damaged or defective items sent back (app/services/help-desk-return.server.ts).
  // returnStatus: empty (not a return), Pending, Label sent, Received or Rejected.
  // returnLabelId: the return label staff sent, a HelpDeskAttachment.
  returnStatus    String    @default("")
  returnNote      String    @default("")
  returnLabelId   String    @default("")
  returnDecidedBy String    @default("")
  returnDecidedAt DateTime?
  // Order edit requests (app/services/help-desk-edit.server.ts): items changed,
  // removed or added. editStatus: empty (not an edit), Pending, Updated or Rejected.
  editStatus    String    @default("")
  editNote      String    @default("")
  editDecidedBy String    @default("")
  editDecidedAt DateTime?
  // Missing or lost parts (app/services/help-desk-replacement.server.ts).
  // replacementStatus: empty (not a missing part), Pending, Approved, Shipped or Rejected.
  replacementStatus      String    @default("")
  replacementNote        String    @default("")
  replacementCarrier     String    @default("")
  replacementTracking    String    @default("")
  replacementTrackingUrl String    @default("")
  replacementDecidedBy   String    @default("")
  replacementDecidedAt   DateTime?
  // missing (a missing part) or warranty (a warranty claim); and for a warranty,
  // the solution the team approved: Replacement, Repair, Store credit or Other.
  replacementKind        String    @default("")
  replacementSolution    String    @default("")
  // International shipping quotes (app/services/help-desk-quote.server.ts).
  // quoteStatus: empty (not a quote), Pending, Quoted or Unavailable; what the team sent.
  quoteStatus     String    @default("")
  quoteCarrier    String    @default("")
  quoteDelivery   String    @default("")
  quoteShipping   String    @default("")
  quoteTaxes      String    @default("")
  quoteNote       String    @default("")
  quoteDecidedBy  String    @default("")
  quoteDecidedAt  DateTime?
  // When staff last opened the ticket; later messages are marked new.
  staffReadAt DateTime?
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  lastActivityAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  attachments HelpDeskAttachment[]
  messages    HelpDeskMessage[]
  emails      HelpDeskEmail[]
  pushSubscriptions HelpDeskPushSubscription[]

  @@unique([shop, requestKey])
  @@unique([shop, number])
  @@index([shop, createdAt])
  @@index([shop, lastActivityAt])
  @@index([shop, customerId])
  @@index([shop, category])
  @@index([shop, carrier])
  @@index([shop, cancelStatus])
  @@index([shop, addressStatus])
  @@index([shop, returnStatus])
  @@index([shop, editStatus])
  @@index([shop, replacementStatus])
  @@index([shop, quoteStatus])
  @@index([shop, humanRequestedAt])
}

// Conversation after the original request. kind: customer (portal reply),
// reply (staff reply, visible to the customer), note (internal) or event (log).
model HelpDeskMessage {
  id        String   @id @default(cuid())
  ticketId  String
  kind      String
  author    String
  body      String
  emailed   Boolean  @default(false)
  createdAt DateTime @default(now())
  ticket    HelpDeskTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

// Help articles: answers customers find by searching the storefront form
// (app/services/help-desk-articles.ts). The starter set is added once per store.
model HelpDeskFaq {
  id        String   @id @default(cuid())
  shop      String
  question  String
  // Comma-separated words and phrases customers might use.
  keywords  String   @default("")
  answer    String
  // One of articleCollections, to browse by.
  collection String  @default("")
  // The storefront form's flow the article's button opens ("Orders › Track Order"), or "".
  action    String   @default("")
  // A starter article's lasting name (help-desk-articles.server.ts), "" for the store's own.
  starterKey String  @default("")
  // Saved by the team in Settings: a starter article is then theirs, never updated by the app.
  edited     Boolean @default(false)
  // "Did this answer your question?" votes.
  helpful    Int     @default(0)
  notHelpful Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([shop])
  @@index([shop, starterKey])
}

// What customers searched for in the help articles. result: faq (an article
// was opened), shopify (a store policy, page or product), none (nothing
// matched), or the old chat bot's order and escalated.
model HelpDeskBotQuestion {
  id        String   @id @default(cuid())
  shop      String
  question  String
  result    String
  faqId     String?
  createdAt DateTime @default(now())

  @@index([shop, createdAt])
}

// Outgoing emails, sent from a queue with retries.
// kind: new-ticket, customer-reply (to the store), ack, reply, status, cancellation, address, return, edit, replacement, quote (to the customer).
// status: pending, processing, sent, skipped or failed.
model HelpDeskEmail {
  id            String    @id @default(cuid())
  shop          String
  ticketId      String
  messageId     String?
  kind          String
  status        String    @default("pending")
  attempts      Int       @default(0)
  lastError     String    @default("")
  nextAttemptAt DateTime  @default(now())
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
  ticket        HelpDeskTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([ticketId])
}

// Saved replies agents can insert into a response.
model HelpDeskMacro {
  id        String   @id @default(cuid())
  shop      String
  title     String
  body      String
  // From help-desk-taxonomy.ts, so the reply box suggests replies that fit the
  // ticket. Empty category: a general reply; empty subcategory: the whole category.
  category    String @default("")
  subcategory String @default("")
  createdAt DateTime @default(now())

  @@index([shop])
}

model HelpDeskAttachment {
  id       String @id @default(cuid())
  ticketId String
  name     String
  type     String
  data     Bytes
  // Set for images sent with a later customer message; null for the original request.
  messageId String?
  // A product issue's photo or video: the product it shows (a Shopify product gid), else "".
  productId String @default("")
  ticket   HelpDeskTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  scan     HelpDeskImageScan?

  @@index([messageId])
}

// AI / authenticity scan of one customer image. Each *Result column holds
// one detection layer's JSON (see app/services/image-scan/).
// status: pending, completed or failed.
// overallVerdict: likely_ai, duplicate, uncertain, likely_real or error.
model HelpDeskImageScan {
  id                      String   @id @default(cuid())
  attachmentId            String   @unique
  shop                    String
  status                  String   @default("pending")
  overallVerdict          String?
  overallConfidence       Float?
  contentHash             String?
  perceptualHash          String?
  duplicateOfAttachmentId String?
  c2paResult              String?
  watermarkResult         String?
  exifResult              String?
  hashResult              String?
  classifierResult        String?
  editResult              String?
  error                   String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  attachment              HelpDeskAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@index([shop, contentHash])
  @@index([status, updatedAt])
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}



model HelpDeskSettings {
  shop        String  @id
  notify      Boolean @default(true)
  notifyEmail String  @default("")
  // Email customers a confirmation with their ticket number and tracking link.
  autoReply   Boolean @default(true)
  signature   String  @default("")
  // Comma-separated names agents can assign tickets to.
  team        String  @default("")
  // Email the customer when staff move a ticket to In progress or Resolved.
  statusEmails Boolean @default(true)
  chatEnabled  Boolean @default(true)
  chatGreeting String  @default("")
  // Starter FAQs are added once, so deleting them sticks.
  faqsSeeded   Boolean @default(false)
  // Starter help articles the store deleted (comma-separated keys), so they aren't added back.
  dismissedArticles String @default("")
  // The request page's chat assistant: on or off, and the store's own wording
  // for its messages (JSON, see help-desk-assistant.ts); blank uses the defaults.
  assistantEnabled Boolean @default(true)
  assistantCopy    String  @default("")
  // AI photo check. Mode: always (detector for every photo layers 1-4 can't
  // settle), suspicious (skips clear camera originals) or manual. Detector
  // credentials are the store's own; they're never sent back to the browser.
  aiDetectionEnabled  Boolean @default(true)
  aiDetectorMode      String  @default("always")
  aiDetectionProvider String  @default("sightengine")
  sightengineUser     String  @default("")
  sightengineSecret   String  @default("")
  truthscanKey        String  @default("")
  // When the storefront form and chat widget last loaded on the store, so the
  // admin can show whether they're actually live.
  formLastSeenAt      DateTime?
  chatLastSeenAt      DateTime?
  // Set once the merchant has saved a chatbot answer or chat setting.
  faqsReviewed        Boolean @default(false)
  // Shipping times shown on the storefront form (JSON: processing days, transit
  // days by rate name, a note). See app/services/help-desk-shipping.ts.
  shippingTimes       String  @default("")
  // ShipStation (V1 API key and secret, the store's own; never sent back to the
  // browser) and which ShipStation store holds this shop's orders. Address
  // changes are checked against its shipping labels (help-desk-shipstation.server.ts).
  shipstationKey      String  @default("")
  shipstationSecret   String  @default("")
  shipstationStoreId  String  @default("")
  // Google Places API key for address suggestions on the storefront form
  // (help-desk-places.server.ts). Never sent back to the browser.
  googlePlacesKey     String  @default("")
  // Browser notifications of team replies (Web Push): the store's VAPID key
  // pair, made the first time it's needed. The private key never leaves the server.
  pushPublicKey       String  @default("")
  pushPrivateKey      String  @default("")
}

// A customer's browser that asked to be notified when the team replies on
// their request (Web Push). Removed when the browser says it's gone.
model HelpDeskPushSubscription {
  id        String   @id @default(cuid())
  ticketId  String
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  ticket    HelpDeskTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // One browser can follow several requests.
  @@unique([ticketId, endpoint])
  @@index([endpoint])
}

// Shopify staff who have opened the Help Desk, so tickets can be assigned to
// them. Recorded from the online session; works on every Shopify plan.
model HelpDeskStaff {
  id           String   @id @default(cuid())
  shop         String
  userId       String
  name         String
  email        String   @default("")
  accountOwner Boolean  @default(false)
  hidden       Boolean  @default(false)
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  @@unique([shop, userId])
  @@index([shop])
}
